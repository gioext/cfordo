{
  "name": "cfordo-combined-test",
  "main": "workers/combined.ts",
  "compatibility_date": "2026-10-23",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cfordo-combined-test",
      "database_id": "00000000-0000-0000-0000-000000000001",
    },
  ],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "cfordo-combined-jobs" }],
    "consumers": [{ "queue": "cfordo-combined-jobs", "max_batch_timeout": 0 }],
  },
  "workflows": [
    {
      "binding": "WORKFLOW",
      "name": "cfordo-combined-workflow",
      "class_name": "CombinedWorkflow",
    },
  ],
}
