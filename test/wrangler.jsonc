{
  "name": "cfordo-test",
  "main": "workers/worker.ts",
  "tsconfig": "../tsconfig.json",
  "compatibility_date": "2026-10-23",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cfordo-test",
      "database_id": "00000000-0000-0000-0000-000000000001",
    },
  ],
  "queues": {
    "producers": [{ "binding": "QUEUE", "queue": "cfordo-test-jobs" }],
    "consumers": [{ "queue": "cfordo-test-jobs", "max_batch_timeout": 0 }],
  },
  "workflows": [
    {
      "binding": "WORKFLOW",
      "name": "cfordo-test-workflow",
      "class_name": "TestWorkflow",
    },
  ],
}
