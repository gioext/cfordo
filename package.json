{
  "name": "cfordo",
  "version": "0.3.0",
  "description": "Playbook-driven jobs for Cloudflare Cron Triggers, Queues and D1.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.ja.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "format": "npx --yes prettier --write . --no-config --no-editorconfig '!example/worker-configuration.d.ts' '!pnpm-lock.yaml'",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsrs --emitDeclarationOnly && esbuild src/index.ts --bundle --format=esm --platform=neutral --target=es2022 --packages=external --loader:.sql=text --sourcemap --outfile=dist/index.js",
    "typecheck": "tsrs --noEmit",
    "check": "pnpm typecheck && pnpm build && pnpm --filter @cfordo/example typecheck",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm check",
    "deploy": "pnpm publish --access public"
  },
  "dependencies": {
    "hono": "4.13.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261030.1",
    "esbuild": "0.28.2",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "wrangler": "4.156.0"
  }
}
