{
  "name": "example-ordo",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "example-ordo-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "remote": true,
    },
  ],
  "queues": {
    "producers": [{ "binding": "QUEUE", "queue": "example-ordo-queue" }],
    "consumers": [
      {
        "queue": "example-ordo-queue",
        "max_batch_timeout": 0,
        "max_retries": 3,
        "retry_delay": 10,
      },
    ],
  },
  "triggers": { "crons": ["* * * * *"] },
}
